{
  "expo": {
    "name": "LaundryAlert",
    "slug": "laundryalert",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.laundryalert.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "LaundryAlert memakai kamera untuk memotret cucian saat pengajuan.",
          "photosPermission": "LaundryAlert membuka galeri untuk melampirkan foto cucian."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "31dc96ee-5ff9-4839-8086-1ddc0bbc7c10"
      }
    },
    "owner": "michaelsuper"
  }
}
